    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Edge Bar"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".QrScanActivity" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:exported="false" />

         <activity
            android:name=".LockOverlayActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:exported="false" />
                <activity
    android:name=".ScreenshotPermissionActivity"
    android:theme="@android:style/Theme.Translucent.NoTitleBar"
    android:excludeFromRecents="true"
    android:taskAffinity=""
    android:launchMode="singleInstance"
    android:noHistory="true"
    android:exported="false" />
                <activity
    android:name=".ScreenRecordPermissionActivity"
    android:theme="@android:style/Theme.Translucent.NoTitleBar"
    android:excludeFromRecents="true"
    android:taskAffinity=""
    android:launchMode="singleInstance"
    android:noHistory="true"
    android:exported="false" />
                <receiver
    android:name=".HomebDeviceAdminReceiver"
    android:permission="android.permission.BIND_DEVICE_ADMIN"
    android:exported="true">
    <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/homeb_device_admin" />
    <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
    </intent-filter>
</receiver>
                <receiver android:name=".ToggleReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.manhmoc.edgebar.TOGGLE_ACC" />
                <action android:name="com.manhmoc.edgebar.TOGGLE_APP" />
            </intent-filter>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="true">
    <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <!-- [MỚI] Android tự gửi broadcast này cho CHÍNH app khi vừa được
             ghi đè cập nhật xong — không cần quyền đặc biệt nào thêm. -->
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
    </intent-filter>
</receiver>
        <receiver android:name=".HomaccWatchdogReceiver" android:exported="false" />
       <receiver android:name=".HomebWatchdogReceiver" android:exported="false" />
        <service
            android:name=".EdgeBarService"
            android:exported="true"
            android:label="Edge Bar Trợ Năng"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config" />
        </service>

        <service android:name=".HomescreenService" android:exported="false"
    android:foregroundServiceType="mediaProjection" />
<service android:name=".ScreenRecorderService" android:exported="false"
    android:foregroundServiceType="mediaProjection|mediaPlayback" />
<service android:name=".VolumeButtonService" android:exported="false"
    android:foregroundServiceType="mediaPlayback" />
<service android:name=".MyPlaylistService" android:exported="false"
    android:foregroundServiceType="mediaPlayback" />
<service android:name=".VoiceRecorderService" android:exported="false"
    android:foregroundServiceType="microphone|mediaPlayback" />
<service android:name=".AccessibleHomeService" android:exported="false" android:foregroundServiceType="specialUse">
    <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="edgebar_accessible_home_overlay" />
</service>
